---
/**
 * صفحة التواصل: بيانات التواصل الموثقة، ونموذج طلب عرض السعر، والخريطة.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Icon from '../components/ui/Icon.astro';
import QuoteForm from '../components/contact/QuoteForm.astro';
import { company, contact, mapLinks } from '../config/site';
import type { Locale } from '../i18n/locales';
import { t } from '../i18n/ui';
import { getContent } from '../content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const ui = t(locale);
const { contactPage: c } = getContent(locale);
---

<BaseLayout locale={locale} page="contact" title={c.meta.title} description={c.meta.description}>
  <PageHero locale={locale} title={c.hero.title} lead={c.hero.lead} />

  <section class="section">
    <div class="container contact">
      <aside class="contact__details" aria-labelledby="details-title">
        <h2 id="details-title">{c.details.title}</h2>
        <p class="contact__company">{company.legalName}</p>
        <ul role="list">
          {contact.phones.map((p) => (
            <li>
              <span class="contact__icon"><Icon name="phone" size={20} /></span>
              <div>
                <span class="contact__label">{c.details.phone}</span>
                <a href={`tel:${p.e164}`}><span class="ltr">{p.display}</span></a>
              </div>
            </li>
          ))}
          <li>
            <span class="contact__icon"><Icon name="mail" size={20} /></span>
            <div>
              <span class="contact__label">{c.details.email}</span>
              <a href={`mailto:${contact.email}`}><span class="ltr">{contact.email}</span></a>
            </div>
          </li>
          <li>
            <span class="contact__icon"><Icon name="mapPin" size={20} /></span>
            <div>
              <span class="contact__label">{c.details.address}</span>
              <address>
                {contact.address.city}، {contact.address.district}<br />
                {contact.address.street}، {contact.address.landmark}
              </address>
              <a class="text-link contact__map-link" href={mapLinks.open} target="_blank" rel="noopener">
                {ui.openMap}
                <Icon name="externalLink" size={16} />
              </a>
            </div>
          </li>
          {contact.workingHours && (
            <li>
              <span class="contact__icon"><Icon name="info" size={20} /></span>
              <div>{contact.workingHours}</div>
            </li>
          )}
        </ul>
      </aside>

      <section class="contact__form" id="quote" aria-labelledby="quote-title">
        <h2 id="quote-title">{c.form.title}</h2>
        <p class="contact__form-intro">{c.form.intro}</p>
        <QuoteForm locale={locale} />
      </section>
    </div>
  </section>

  <section class="map" aria-label={c.details.mapTitle}>
    <iframe
      title={c.details.mapTitle}
      src={mapLinks.embed}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </section>
</BaseLayout>

<style>
  .contact { display: grid; gap: clamp(2.5rem, 2rem + 3vw, 4.5rem); align-items: start; }
  @media (min-width: 1024px) { .contact { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); } }

  .contact__details {
    background: var(--c-char); color: var(--c-on-dark);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); border-radius: var(--r-md);
    --focus: #fff;
  }
  @media (min-width: 1024px) { .contact__details { position: sticky; top: calc(var(--header-h) + 24px); } }
  .contact__details h2 { color: #fff; font-size: var(--fs-h3); }
  .contact__company { color: var(--c-on-dark-muted); font-size: var(--fs-sm); margin-block-end: var(--sp-5); }
  .contact__details ul { display: grid; gap: var(--sp-5); padding: 0; }
  .contact__details li { display: flex; gap: var(--sp-4); align-items: flex-start; }
  .contact__icon {
    display: inline-grid; place-items: center; flex-shrink: 0;
    width: 44px; height: 44px; border-radius: 50%; background: rgb(255 255 255 / 0.08); color: #ff7a7f;
  }
  .contact__label { display: block; font-size: var(--fs-xs); color: var(--c-on-dark-muted); }
  .contact__details a:not(.text-link) { color: #fff; font-weight: 600; text-decoration: none; font-size: var(--fs-base); }
  .contact__details a:not(.text-link):hover { text-decoration: underline; }
  .contact__details address { font-style: normal; line-height: 1.85; }
  .contact__map-link { margin-block-start: var(--sp-2); font-size: var(--fs-sm); color: #fff; text-decoration-color: rgb(255 255 255 / 0.4); }

  .contact__form { scroll-margin-top: calc(var(--header-h) + 24px); }
  .contact__form h2 { font-size: var(--fs-h2); }
  .contact__form-intro { color: var(--c-muted); margin-block: var(--sp-2) var(--sp-5); }

  .map { border-block-start: 1px solid var(--c-line); background: var(--c-mist); }
  .map iframe { display: block; width: 100%; height: clamp(300px, 40vw, 440px); border: 0; filter: grayscale(0.35); }
</style>
