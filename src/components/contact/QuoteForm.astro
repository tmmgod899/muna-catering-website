---
/**
 * نموذج طلب عرض السعر.
 *
 * يملأ العميل النموذج مرة واحدة ثم يختار طريقة الإرسال:
 * - البريد الإلكتروني: يُرسَل الطلب إلى بريد الشركة عبر خدمة Web3Forms (انظر quoteRequest في src/config/site.ts).
 *   لا تُعرض رسالة نجاح إلا بعد تأكيد الخدمة استلام الطلب (success: true).
 * - واتساب: تُفتح محادثة مع رقم الشركة وفيها رسالة منسقة بتفاصيل الطلب، ويضغط العميل «إرسال» بنفسه.
 * عند عدم ضبط مفتاح Web3Forms يُخفى خيار البريد تلقائيًا ويبقى خيار واتساب.
 */
import Icon from '../ui/Icon.astro';
import { contact, quoteRequest } from '../../config/site';
import type { Locale } from '../../i18n/locales';
import { getContent } from '../../content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const { contactPage } = getContent(locale);
const f = contactPage.form;
const phone = contact.phones[0];
const emailEnabled = quoteRequest.emailEnabled;
const whatsappEnabled = Boolean(contact.whatsapp);

// تسميات الحقول بالترتيب المستخدم في رسالة البريد ورسالة واتساب
const labels = {
  name: f.fields.name.label,
  company: f.fields.company.label,
  phone: f.fields.phone.label,
  email: f.fields.email.label,
  service: f.fields.service.label,
  date: f.fields.date.label,
  quantity: f.fields.quantity.label,
  location: f.fields.location.label,
  details: f.fields.details.label,
};
---

<form
  class="quote-form"
  novalidate
  data-quote-form
  data-access-key={emailEnabled ? quoteRequest.accessKey : undefined}
  data-endpoint={emailEnabled ? quoteRequest.endpoint : undefined}
  data-subject={quoteRequest.emailSubject}
  data-from-name={quoteRequest.emailFromName}
  data-whatsapp={contact.whatsapp ?? undefined}
  data-dup-minutes={quoteRequest.duplicateWindowMinutes}
  data-messages={JSON.stringify(f.errors)}
  data-labels={JSON.stringify(labels)}
  data-text={JSON.stringify(f.message)}
  aria-describedby="form-required-note"
>
  <p id="form-required-note" class="quote-form__note">{f.requiredNote}</p>

  <div class="quote-form__error-summary" role="alert" data-error-summary hidden>
    <Icon name="info" size={20} />
    <span>{f.errors.summary}</span>
  </div>

  <div class="quote-form__grid">
    <div class="field">
      <label for="qf-name">{labels.name} <span aria-hidden="true">*</span></label>
      <input id="qf-name" name="name" type="text" autocomplete={f.fields.name.autocomplete} required maxlength="120" aria-describedby="qf-name-error" />
      <p class="field__error" id="qf-name-error" data-error-for="name"></p>
    </div>

    <div class="field">
      <label for="qf-company">{labels.company}</label>
      <input id="qf-company" name="company" type="text" autocomplete={f.fields.company.autocomplete} maxlength="160" aria-describedby="qf-company-hint" />
      <p class="field__hint" id="qf-company-hint">{f.fields.company.hint}</p>
    </div>

    <div class="field">
      <label for="qf-phone">{labels.phone} <span aria-hidden="true">*</span></label>
      <input id="qf-phone" name="phone" type="tel" inputmode="tel" dir="ltr" autocomplete={f.fields.phone.autocomplete} required maxlength="20" aria-describedby="qf-phone-hint qf-phone-error" />
      <p class="field__hint" id="qf-phone-hint">{f.fields.phone.hint}</p>
      <p class="field__error" id="qf-phone-error" data-error-for="phone"></p>
    </div>

    <div class="field">
      <label for="qf-email">{labels.email} <span aria-hidden="true">*</span></label>
      <input id="qf-email" name="email" type="email" inputmode="email" dir="ltr" autocomplete={f.fields.email.autocomplete} required maxlength="160" aria-describedby="qf-email-error" />
      <p class="field__error" id="qf-email-error" data-error-for="email"></p>
    </div>

    <div class="field">
      <label for="qf-service">{labels.service} <span aria-hidden="true">*</span></label>
      <select id="qf-service" name="service" required aria-describedby="qf-service-error">
        <option value="">{f.fields.service.placeholder}</option>
        {f.serviceOptions.map((o) => <option value={o}>{o}</option>)}
      </select>
      <p class="field__error" id="qf-service-error" data-error-for="service"></p>
    </div>

    <div class="field">
      <label for="qf-date">{labels.date} <span aria-hidden="true">*</span></label>
      <input id="qf-date" name="date" type="date" dir="ltr" required aria-describedby="qf-date-hint qf-date-error" />
      <p class="field__hint" id="qf-date-hint">{f.fields.date.hint}</p>
      <p class="field__error" id="qf-date-error" data-error-for="date"></p>
    </div>

    <div class="field">
      <label for="qf-quantity">{labels.quantity}</label>
      <input id="qf-quantity" name="quantity" type="text" inputmode="numeric" dir="ltr" maxlength="7" aria-describedby="qf-quantity-hint qf-quantity-error" />
      <p class="field__hint" id="qf-quantity-hint">{f.fields.quantity.hint}</p>
      <p class="field__error" id="qf-quantity-error" data-error-for="quantity"></p>
    </div>

    <div class="field">
      <label for="qf-location">{labels.location} <span aria-hidden="true">*</span></label>
      <input id="qf-location" name="location" type="text" required maxlength="160" aria-describedby="qf-location-hint qf-location-error" />
      <p class="field__hint" id="qf-location-hint">{f.fields.location.hint}</p>
      <p class="field__error" id="qf-location-error" data-error-for="location"></p>
    </div>

    <div class="field field--full">
      <label for="qf-details">{labels.details}</label>
      <textarea id="qf-details" name="details" rows="5" maxlength="2000" aria-describedby="qf-details-hint"></textarea>
      <p class="field__hint" id="qf-details-hint">{f.fields.details.hint}</p>
    </div>
  </div>

  <!-- حقل مخفي لاعتراض الرسائل الآلية؛ لا يراه الزائر -->
  <div class="quote-form__hp" aria-hidden="true">
    <label>Leave this empty<input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="quote-form__send">
    {emailEnabled && whatsappEnabled && <p class="quote-form__prompt">{f.channels.prompt}</p>}
    <div class="quote-form__actions">
      {emailEnabled && (
        <button class="btn" type="submit" value="email" data-channel="email">
          <Icon name="mail" size={18} />
          <span data-label>{f.channels.email}</span>
        </button>
      )}
      {whatsappEnabled && (
        <button class:list={['btn', emailEnabled && 'btn--outline']} type="submit" value="whatsapp" data-channel="whatsapp">
          <Icon name="messageCircle" size={18} />
          <span data-label>{emailEnabled ? f.channels.whatsapp : f.channels.whatsappOnly}</span>
        </button>
      )}
    </div>
    {emailEnabled && <p class="quote-form__privacy">{f.channels.privacy}</p>}
  </div>

  <div class="quote-form__result" data-result tabindex="-1" role="status" aria-live="polite" hidden>
    <div class="result result--success" data-result-kind="success" hidden>
      <Icon name="circleCheck" size={26} />
      <div>
        <h3>{f.results.emailSuccessTitle}</h3>
        <p>{f.results.emailSuccessBody}</p>
      </div>
    </div>
    <div class="result result--success" data-result-kind="duplicate" hidden>
      <Icon name="circleCheck" size={26} />
      <div>
        <h3>{f.results.duplicateTitle}</h3>
        <p>{f.results.duplicateBody}</p>
      </div>
    </div>
    <div class="result result--error" data-result-kind="error" hidden>
      <Icon name="triangleAlert" size={26} />
      <div>
        <h3>{f.results.errorTitle}</h3>
        <p data-error-text data-default={f.results.errorBody} data-rate-limit={f.results.rateLimitBody}>{f.results.errorBody}</p>
        <div class="result__actions">
          {whatsappEnabled && (
            <button type="button" class="btn btn--sm" data-retry-whatsapp>
              <Icon name="messageCircle" size={18} />{f.channels.whatsapp}
            </button>
          )}
          {phone && (
            <a class="btn btn--sm btn--outline" href={`tel:${phone.e164}`}>
              <Icon name="phone" size={18} /><span class="ltr">{phone.display}</span>
            </a>
          )}
        </div>
      </div>
    </div>
    <div class="result result--info" data-result-kind="whatsapp" hidden>
      <Icon name="messageCircle" size={26} />
      <div>
        <h3>{f.results.whatsappTitle}</h3>
        <p>{f.results.whatsappBody}</p>
        <a class="text-link" href="#" target="_blank" rel="noopener" data-whatsapp-fallback>{f.results.whatsappFallback}</a>
      </div>
    </div>
  </div>

  <noscript>
    <p class="quote-form__noscript">
      يتطلب إرسال النموذج تفعيل JavaScript في المتصفح. يمكنكم التواصل معنا مباشرة عبر الجوال
      {phone && <a href={`tel:${phone.e164}`}><span class="ltr">{phone.display}</span></a>}
      أو البريد الإلكتروني <a href={`mailto:${contact.email}`}><span class="ltr">{contact.email}</span></a>.
    </p>
  </noscript>
</form>

<script>
  type FieldName = 'name' | 'company' | 'phone' | 'email' | 'service' | 'date' | 'quantity' | 'location' | 'details';
  type Messages = Record<'required' | 'email' | 'phone' | 'number' | 'date' | 'summary', string>;
  type Text = Record<'heading' | 'headingEn' | 'empty' | 'sentFrom' | 'sentAt', string>;
  type ResultKind = 'success' | 'duplicate' | 'error' | 'whatsapp';

  const FIELDS: FieldName[] = ['name', 'company', 'phone', 'email', 'service', 'date', 'quantity', 'location', 'details'];
  const DUP_KEY = 'muna-quote-last-sent';

  const form = document.querySelector<HTMLFormElement>('[data-quote-form]');
  if (form) {
    const cfg = form.dataset;
    const messages: Messages = JSON.parse(cfg.messages ?? '{}');
    const labels: Record<FieldName, string> = JSON.parse(cfg.labels ?? '{}');
    const text: Text = JSON.parse(cfg.text ?? '{}');
    const summary = form.querySelector<HTMLElement>('[data-error-summary]')!;
    const result = form.querySelector<HTMLElement>('[data-result]')!;
    const channelButtons = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-channel]'));
    const dateInput = form.querySelector<HTMLInputElement>('#qf-date')!;
    const honeypot = form.querySelector<HTMLInputElement>('input[name="botcheck"]')!;
    let sending = false;

    // تاريخ اليوم بالتوقيت المحلي (yyyy-mm-dd) حدًّا أدنى لحقل التاريخ
    const todayIso = () => {
      const d = new Date();
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    };
    dateInput.min = todayIso();

    // تحويل الأرقام العربية الهندية والفارسية إلى أرقام غربية
    const normalizeDigits = (value: string) =>
      value.replace(/[٠-٩]/g, (d) => String('٠١٢٣٤٥٦٧٨٩'.indexOf(d))).replace(/[۰-۹]/g, (d) => String('۰۱۲۳۴۵۶۷۸۹'.indexOf(d)));

    const value = (name: FieldName) => (form.elements.namedItem(name) as HTMLInputElement | null)?.value ?? '';

    const validators: Partial<Record<FieldName, (v: string) => string | null>> = {
      name: (v) => (v.trim().length < 2 ? messages.required : null),
      phone: (v) => {
        const digits = normalizeDigits(v).replace(/[\s\-().]/g, '');
        if (!digits) return messages.required;
        const saudi = /^(?:\+9665|009665|9665|05)\d{8}$/.test(digits);
        const international = /^(?:\+|00)[1-9]\d{7,14}$/.test(digits);
        return saudi || international ? null : messages.phone;
      },
      email: (v) => {
        if (!v.trim()) return messages.required;
        return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()) ? null : messages.email;
      },
      service: (v) => (v ? null : messages.required),
      date: (v) => {
        if (!v) return messages.required;
        if (!/^\d{4}-\d{2}-\d{2}$/.test(v) || Number.isNaN(new Date(`${v}T00:00:00`).getTime())) return messages.date;
        return v < todayIso() ? messages.date : null;
      },
      quantity: (v) => {
        const n = normalizeDigits(v).trim().replace(/[,،\s]/g, '');
        if (!n) return null;
        return /^[1-9]\d*$/.test(n) ? null : messages.number;
      },
      location: (v) => (v.trim().length < 2 ? messages.required : null),
    };

    const setError = (name: FieldName, message: string | null) => {
      const field = form.elements.namedItem(name) as HTMLInputElement | null;
      const slot = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (!field || !slot) return;
      slot.textContent = message ?? '';
      field.setAttribute('aria-invalid', message ? 'true' : 'false');
    };

    const validateField = (name: FieldName) => {
      const validator = validators[name];
      if (!validator) return true;
      const error = validator(value(name));
      setError(name, error);
      return !error;
    };

    (Object.keys(validators) as FieldName[]).forEach((name) => {
      const field = form.elements.namedItem(name) as HTMLInputElement | null;
      field?.addEventListener('blur', () => { if (field.value) validateField(name); });
      field?.addEventListener('input', () => { if (field.getAttribute('aria-invalid') === 'true') validateField(name); });
      field?.addEventListener('change', () => { if (field.getAttribute('aria-invalid') === 'true') validateField(name); });
    });

    const validateAll = () => {
      const invalid = (Object.keys(validators) as FieldName[]).filter((name) => !validateField(name));
      summary.hidden = invalid.length === 0;
      if (invalid.length) (form.elements.namedItem(invalid[0]) as HTMLElement | null)?.focus();
      return invalid.length === 0;
    };

    // التاريخ بصيغتيه الميلادية والهجرية (تقويم أم القرى) لتسهيل قراءته
    const formatDate = (iso: string) => {
      try {
        const d = new Date(`${iso}T12:00:00`);
        const hijri = new Intl.DateTimeFormat('ar-SA-u-ca-islamic-umalqura-nu-latn', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
        return `${iso} م (${hijri})`;
      } catch {
        return iso;
      }
    };

    /** بيانات الطلب منسقة بالترتيب: [التسمية، القيمة] */
    const collect = (): [string, string][] =>
      FIELDS.map((name) => {
        let v = value(name).trim();
        if (name === 'phone' || name === 'quantity') v = normalizeDigits(v);
        if (name === 'date' && v) v = formatDate(v);
        return [labels[name], v || text.empty];
      });

    const fingerprint = () => FIELDS.map((n) => normalizeDigits(value(n)).trim().toLowerCase()).join('␟');

    const showResult = (kind: ResultKind) => {
      result.hidden = false;
      result.querySelectorAll<HTMLElement>('[data-result-kind]').forEach((el) => { el.hidden = el.dataset.resultKind !== kind; });
      result.focus({ preventScroll: false });
    };

    const setSending = (state: boolean, active?: HTMLButtonElement) => {
      sending = state;
      channelButtons.forEach((btn) => {
        btn.disabled = state;
        const label = btn.querySelector<HTMLElement>('[data-label]');
        if (!label) return;
        if (state && btn === active) {
          label.dataset.original = label.textContent ?? '';
          label.textContent = '…';
          btn.setAttribute('aria-busy', 'true');
        } else if (!state && label.dataset.original) {
          label.textContent = label.dataset.original;
          btn.removeAttribute('aria-busy');
        }
      });
    };

    const readLastSent = (): { fp: string; at: number } | null => {
      try { return JSON.parse(sessionStorage.getItem(DUP_KEY) ?? 'null'); } catch { return null; }
    };
    const writeLastSent = (fp: string) => {
      try { sessionStorage.setItem(DUP_KEY, JSON.stringify({ fp, at: Date.now() })); } catch { /* التخزين غير متاح */ }
    };

    // ——— واتساب: رسالة منسقة يرسلها العميل بنفسه ———
    const sendWhatsApp = () => {
      const lines = collect().map(([label, v]) => `*${label}:* ${v}`);
      const message = [`*${text.heading}*`, text.headingEn, '', ...lines].join('\n');
      const url = `https://wa.me/${cfg.whatsapp}?text=${encodeURIComponent(message)}`;
      const fallback = form.querySelector<HTMLAnchorElement>('[data-whatsapp-fallback]');
      if (fallback) fallback.href = url;
      const win = window.open(url, '_blank');
      if (win) win.opener = null;
      else window.location.href = url;
      showResult('whatsapp');
    };

    // ——— البريد الإلكتروني عبر Web3Forms ———
    const sendEmail = async (button: HTMLButtonElement) => {
      const fp = fingerprint();
      const last = readLastSent();
      const windowMs = Number(cfg.dupMinutes ?? 30) * 60_000;
      if (last && last.fp === fp && Date.now() - last.at < windowMs) {
        showResult('duplicate');
        return;
      }

      const payload: Record<string, string | boolean> = {
        access_key: cfg.accessKey ?? '',
        subject: cfg.subject ?? '',
        from_name: cfg.fromName ?? '',
        replyto: value('email').trim(),
      };
      for (const [label, v] of collect()) payload[label] = v;
      payload[text.sentFrom] = window.location.href;
      payload[text.sentAt] = new Date().toLocaleString('ar-SA-u-nu-latn', { timeZone: 'Asia/Riyadh', dateStyle: 'medium', timeStyle: 'short' });
      if (honeypot.checked) payload.botcheck = true;

      const errorText = form.querySelector<HTMLElement>('[data-error-text]')!;
      errorText.textContent = errorText.dataset.default ?? '';
      setSending(true, button);
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), 20_000);
      try {
        const response = await fetch(cfg.endpoint!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });
        const data = await response.json().catch(() => null);
        if (response.ok && data?.success === true) {
          writeLastSent(fp);
          form.reset();
          summary.hidden = true;
          showResult('success');
          return;
        }
        if (response.status === 429) errorText.textContent = errorText.dataset.rateLimit ?? errorText.textContent;
        showResult('error');
      } catch {
        showResult('error');
      } finally {
        window.clearTimeout(timer);
        setSending(false);
      }
    };

    // يُحفظ الزر المضغوط احتياطًا للمتصفحات التي لا تدعم SubmitEvent.submitter
    let lastClicked: HTMLButtonElement | null = null;
    channelButtons.forEach((btn) => btn.addEventListener('click', () => { lastClicked = btn; }));

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (sending) return;
      const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
      const button = submitter?.dataset.channel ? submitter : lastClicked ?? channelButtons[0];
      lastClicked = null;
      if (!button) return;
      result.hidden = true;
      if (!validateAll()) return;
      if (button.dataset.channel === 'whatsapp') sendWhatsApp();
      else void sendEmail(button);
    });

    form.querySelector('[data-retry-whatsapp]')?.addEventListener('click', () => {
      if (validateAll()) sendWhatsApp();
    });
  }
</script>

<style>
  .quote-form { display: grid; gap: var(--sp-4); }
  .quote-form__note { font-size: var(--fs-sm); color: var(--c-muted); }
  .quote-form__error-summary {
    display: flex; gap: var(--sp-2); align-items: center;
    padding: var(--sp-3) var(--sp-4); border-radius: var(--r-md);
    background: var(--c-red-soft); color: var(--c-red-strong); font-weight: 500; font-size: var(--fs-sm);
  }
  .quote-form__error-summary[hidden] { display: none; }
  .quote-form__grid { display: grid; gap: var(--sp-4) var(--sp-5); }
  @media (min-width: 640px) {
    .quote-form__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .field--full { grid-column: 1 / -1; }
  }
  .field { display: grid; gap: var(--sp-1); align-content: start; }
  .field label { font-weight: 600; font-size: var(--fs-sm); color: var(--c-char); }
  .field label span { color: var(--c-red); }
  .field input, .field select, .field textarea {
    width: 100%; min-height: 48px;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--c-line-strong); border-radius: var(--r-md);
    background: #fff; font-size: var(--fs-base); line-height: 1.5;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .field input[dir='ltr'] { text-align: right; }
  :global([dir='ltr']) .field input[dir='ltr'] { text-align: left; }
  .field input[type='date'] { appearance: none; -webkit-appearance: none; min-height: 48px; }
  .field textarea { resize: vertical; min-height: 130px; }
  .field input:hover, .field select:hover, .field textarea:hover { border-color: var(--c-muted); }
  .field input:focus-visible, .field select:focus-visible, .field textarea:focus-visible {
    outline: none; border-color: var(--c-char); box-shadow: 0 0 0 3px rgb(187 31 37 / 0.25);
  }
  .field [aria-invalid='true'] { border-color: var(--c-red); background: #fffafa; }
  .field__hint { font-size: var(--fs-xs); color: var(--c-muted); }
  .field__error { font-size: var(--fs-xs); font-weight: 600; color: var(--c-red-strong); min-height: 0; }
  .field__error:empty { display: none; }

  .quote-form__hp { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .quote-form__send { display: grid; gap: var(--sp-3); padding-block-start: var(--sp-2); }
  .quote-form__prompt { font-weight: 600; font-size: var(--fs-sm); color: var(--c-char); }
  .quote-form__actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  .quote-form__actions .btn { min-width: 240px; }
  .quote-form__actions .btn:disabled { opacity: 0.7; cursor: progress; }
  .quote-form__privacy { font-size: var(--fs-xs); color: var(--c-muted); }
  @media (max-width: 559px) {
    .quote-form__actions { flex-direction: column; }
    .quote-form__actions .btn { width: 100%; min-width: 0; white-space: normal; }
  }

  .quote-form__result { border-radius: var(--r-md); }
  .quote-form__result:focus { outline: 3px solid var(--focus); outline-offset: 3px; }
  .result {
    display: flex; gap: var(--sp-4); align-items: flex-start;
    padding: var(--sp-5); border-radius: var(--r-md);
