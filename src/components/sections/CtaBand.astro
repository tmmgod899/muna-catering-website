---
/**
 * شريط الدعوة إلى التواصل في نهاية الصفحات.
 */
import Icon from '../ui/Icon.astro';
import { contact } from '../../config/site';
import { routes } from '../../config/navigation';
import { localizedPath, type Locale } from '../../i18n/locales';
import { getContent } from '../../content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const { homePage } = getContent(locale);
const phone = contact.phones[0];
---

<section class="cta-band">
  <svg class="cta-band__ring" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
    <circle cx="100" cy="100" r="92" pathLength="100" />
  </svg>
  <div class="container cta-band__inner">
    <div>
      <h2>{homePage.closing.title}</h2>
      <p>{homePage.closing.body}</p>
    </div>
    <div class="cta-band__actions">
      <a class="btn btn--light" href={localizedPath(`${routes.contact}#quote`, locale)}>{homePage.closing.primary}</a>
      {phone && (
        <a class="btn btn--ghost-light" href={`tel:${phone.e164}`}>
          <Icon name="phone" size={18} />
          <span class="ltr">{phone.display}</span>
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative; overflow: hidden;
    background: var(--c-red);
    color: #fff;
    padding-block: clamp(3rem, 2.2rem + 3vw, 4.75rem);
    --focus: #fff;
  }
  .cta-band__inner {
    position: relative;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: var(--sp-5) var(--sp-7);
  }
  .cta-band h2 { color: #fff; font-size: var(--fs-h2); }
  .cta-band p { margin-block-start: var(--sp-2); max-width: 56ch; color: rgb(255 255 255 / 0.88); font-size: var(--fs-lead); }
  .cta-band__actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  .cta-band__ring {
    position: absolute; inset-inline-end: -90px; top: -120px;
    width: 420px; fill: none; stroke: rgb(255 255 255 / 0.16); stroke-width: 1.5;
    stroke-dasharray: 80 20; transform: rotate(40deg);
  }
  @media (max-width: 479px) {
    .cta-band__actions, .cta-band__actions .btn { width: 100%; }
  }
</style>
