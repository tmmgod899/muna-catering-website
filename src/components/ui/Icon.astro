---
/**
 * أيقونة SVG مضمّنة. الأيقونات الاتجاهية (الأسهم) تنعكس تلقائيًا في الواجهة من اليسار إلى اليمين.
 */
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
  /** نص بديل للأيقونات التي تحمل معنى مستقلًا؛ يُترك فارغًا للأيقونات الزخرفية */
  label?: string;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 20, label, class: className = '', strokeWidth = 1.75 } = Astro.props;
const raw = icons[name];
const inner = raw.replace(/<!--[\s\S]*?-->/g, '').replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
const directional = name === 'arrowLeft' || name === 'chevronLeft' || name === 'chevronRight';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icon', directional && 'icon-dir', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={inner}
/>
