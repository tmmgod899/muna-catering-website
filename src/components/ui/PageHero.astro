---
/**
 * ترويسة الصفحات الداخلية: مسار التنقل والعنوان الرئيسي ونص تمهيدي.
 */
import { localizedPath, type Locale } from '../../i18n/locales';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  lead?: string;
}
const { locale, title, lead } = Astro.props;
const ui = t(locale);
---

<section class="page-hero">
  <svg class="page-hero__ring" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
    <circle cx="100" cy="100" r="92" pathLength="100" />
  </svg>
  <div class="container page-hero__inner">
    <nav aria-label={ui.breadcrumb} class="crumbs">
      <ol role="list">
        <li><a href={localizedPath('/', locale)}>{ui.home}</a></li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>
    <h1>{title}</h1>
    {lead && <p class="page-hero__lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative; overflow: hidden;
    background: var(--c-mist);
    padding-block: clamp(2.75rem, 2rem + 3vw, 4.5rem) clamp(2.5rem, 2rem + 2.5vw, 4rem);
    border-block-end: 1px solid var(--c-line);
  }
  .page-hero__inner { position: relative; }
  .page-hero h1 { font-size: var(--fs-h1); max-width: 22ch; }
  .page-hero__lead {
    margin-block-start: var(--sp-3);
    max-width: 60ch; font-size: var(--fs-lead); color: var(--c-muted); line-height: 1.8;
  }
  .page-hero__ring {
    position: absolute;
    inset-inline-end: clamp(-140px, -6vw, -40px);
    top: 50%;
    width: clamp(220px, 28vw, 380px);
    transform: translateY(-50%) rotate(-120deg);
    fill: none; stroke: var(--c-red); stroke-width: 2.2;
    stroke-dasharray: 78 22;
    opacity: 0.9;
  }
  @media (max-width: 639px) {
    .page-hero__ring { opacity: 0.35; }
  }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: var(--sp-2); padding: 0; font-size: var(--fs-sm); color: var(--c-muted); margin-block-end: var(--sp-3); }
  .crumbs li + li::before { content: '/'; margin-inline-end: var(--sp-2); color: var(--c-line-strong); }
  .crumbs a { color: var(--c-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--c-red); text-decoration: underline; }
  .crumbs [aria-current] { color: var(--c-char); font-weight: 500; }
</style>
